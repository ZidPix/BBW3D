# Shell scripts and anything a Linux container executes MUST keep LF endings.
# Git for Windows converts to CRLF on checkout by default, and a shebang line
# ending in CR makes the kernel look for an interpreter literally named
# "/bin/sh\r" - which surfaces as the deeply misleading error
# "exec ./entrypoint.sh: no such file or directory".
*.sh        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
entrypoint* text eol=lf

# Python runs fine either way, but keep the repo consistent.
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf

# PowerShell is left to the platform default; it reads both, and scripts/*.ps1
# carry a UTF-8 BOM so Windows PowerShell 5.1 decodes them correctly.

# Never munge binaries.
*.png       binary
*.jpg       binary
*.stl       binary
*.step      binary
*.3mf       binary
*.glb       binary
